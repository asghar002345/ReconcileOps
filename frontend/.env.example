# API origin the browser calls. No trailing slash.
# Any non-local origin must also be listed in vercel.json connect-src.
VITE_API_URL=http://127.0.0.1:3000

# Optional. Vite dev/preview proxy target for /api-proxy only (not inlined into the app).
